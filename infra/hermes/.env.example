# Copy to /var/lib/hermes/.env (mode 600). Never commit the real file.
# Generate a key: openssl rand -hex 32
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=replace-me
CUDA_VISIBLE_DEVICES=
HERMES_HOME=/var/lib/hermes

# Optional provider keys may exist on the host for other paths.
# They are not required for local Ollama (angus-local) and must stay out of Git.
# XAI_API_KEY=
# XAI_BASE_URL=https://api.x.ai/v1
